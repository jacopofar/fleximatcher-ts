{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!web/frontend/src/demo-lexicon.json",
      "!package-lock.json",
      "!web/frontend/package-lock.json",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Annotation templates *are* strings containing literal `${1.path}`
        // placeholders, so this rule fights the core of the template syntax.
        "noTemplateCurlyInString": "off"
      },
      "style": {
        // The codebase uses `!` deliberately at invariants the type system
        // cannot see through (compiled patterns, closed tag sets).
        "noNonNullAssertion": "off",
        // style.css is hand-authored; rule order follows the visual design,
        // not specificity ascending order.
        "noDescendingSpecificity": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
