{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "fleximatcher": ["../../src/browser.ts"],
      "fleximatcher/wiktionary/browser": ["../../src/wiktionary/browser.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
